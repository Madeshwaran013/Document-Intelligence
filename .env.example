# Copy this file to .env and fill in real values for local development.
# Never commit a real .env file — it is already listed in .gitignore.

# --- General ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Database ---
# Local SQLite by default. For Postgres/MySQL in production:
#   DATABASE_URL=postgresql+psycopg2://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./storage/app.db

# --- File handling ---
UPLOAD_DIR=./storage/uploads

# --- OCR ---
# "paddle" (local, default, free, no key needed) or "ocr_space"
OCR_PROVIDER=paddle
# Only needed if OCR_PROVIDER=ocr_space (free tier: https://ocr.space/ocrapi)
OCR_SPACE_API_KEY=

# --- LLM extraction ---
# Leave ANTHROPIC_API_KEY blank to run on the built-in heuristic extractor
# (no external calls, works out of the box). Set it to enable LLM-based
# extraction for higher accuracy on varied document layouts.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-6
USE_LLM_EXTRACTION=true

# --- Validation tolerance ---
VALIDATION_RELATIVE_TOLERANCE=0.01
VALIDATION_ABSOLUTE_TOLERANCE=1.0
